# Copy to .env and fill in for your environment. Nothing here is a real secret.

ENVIRONMENT=development

# --- Auth ---
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_ONLY_SECRET_KEY_1234567890
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- LLM provider: anthropic | openai | gemini | offline ---
# "offline" needs no API key and is fully deterministic (used for CI/tests).
LLM_PROVIDER=offline
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- RAG ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35

# --- Agent / safety ---
AGENT_MAX_STEPS=8
AGENT_STEP_TIMEOUT_SECONDS=25
TOOL_CALL_TIMEOUT_SECONDS=15
